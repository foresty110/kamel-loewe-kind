<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kamel.board.mapper.CategoryMapper">


    <select id="findAll" resultType="Category">
        SELECT *
        FROM category
    </select>

    <select id="existsById"
            parameterType="Long"
            resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM category WHERE id = #{categoryId}
        )
    </select>

    <select id="findById"
            parameterType="Long"
            resultType="Category">
        SELECT id,
               name
        FROM category
        WHERE id = #{categoryId}
    </select>
</mapper>